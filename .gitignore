# 依赖
node_modules/

# 密钥 —— 绝不入库(API key 只放 GitHub Secrets)
.env
.env.*
*.key

# pipeline 运行期产物(样本/临时;状态文件按需保留)
pipeline/state/samples/
pipeline/state/demo-*.json
pipeline/state/offline-*.json

# 账号系统与用户数据 —— 整个 state/ 目录为服务器运行态+用户数据(含邮箱/口令哈希/会话/作品库),绝不入库。
# 本地 state/ 仅作同步副本;真相在服务器。hallucination.log 是反幻觉审计日志(无 PII),特意保留。
pipeline/state/*
!pipeline/state/hallucination.log

# 用户数据备份快照 —— 含裸用户数据(users.json/artportal.db/mail-secret 等),绝不入库。
# 回档能力由 backup.mjs 远程快照 + 本地/服务器备份目录保障,不进 git 版本控制。
backups/

# 翻译回滚备份
site/data/opportunities.json.bak-*

# 临时脚本
tmp_*.cjs
tmp_*.mjs

# 系统
.DS_Store
Thumbs.db
*.log
!pipeline/state/hallucination.log

# 部署打包产物
artportal-site.zip
*.zip
site/assets/covers/
site/assets/fonts/noto-serif-sc/files/
pipeline/state/pagetrans.json*
site/assets/avatars/
site/assets/works/
